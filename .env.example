# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (Supabase PostgreSQL via Connection Pooler)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# JWT Authentication
JWT_SECRET="eshraqat-almustaqbal-ultra-secure-jwt-secret-key-2026"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="eshraqat-almustaqbal-ultra-secure-refresh-token-secret-2026"
JWT_REFRESH_EXPIRES_IN="30d"

# Supabase Storage & Services
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_STORAGE_BUCKET="properties"

# Security & CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,https://eshraqat-almustaqbal.vercel.app,https://eshraqat-al-mustaqbal-dashboard.vercel.app"
THROTTLE_TTL=60
THROTTLE_LIMIT=100
